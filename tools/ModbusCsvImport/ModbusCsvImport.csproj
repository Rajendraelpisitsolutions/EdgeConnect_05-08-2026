<!--
  ModbusCsvImport — CLI companion to F4's ModbusTagCsvImporter. Takes a CSV
  file of Modbus tag definitions and emits a JSON fragment ready to paste
  into a `connection.tagDefinitions` block in a gateway config.

  Pure text transform, no config mutation. The tool exists so operators can
  bulk-author tag lists in Excel / a text editor without learning the JSON
  shape. Phase 4's management API will call the same underlying library.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ElpisEdgeConnect.Tools.ModbusCsvImport</RootNamespace>
    <AssemblyName>ModbusCsvImport</AssemblyName>
    <Description>Modbus TCP CSV tag-import CLI — emits a tagDefinitions JSON fragment.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1822;CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sources.ModbusTcp\ElpisEdgeConnect.Sources.ModbusTcp.csproj" />
  </ItemGroup>

</Project>
