<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ElpisEdgeConnect.Integration.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Core\ElpisEdgeConnect.Core.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Host\ElpisEdgeConnect.Host.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sources.Focas2\ElpisEdgeConnect.Sources.Focas2.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sources.MTConnect\ElpisEdgeConnect.Sources.MTConnect.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sources.ModbusTcp\ElpisEdgeConnect.Sources.ModbusTcp.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sinks.Mqtt\ElpisEdgeConnect.Sinks.Mqtt.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sinks.OpcUaServer\ElpisEdgeConnect.Sinks.OpcUaServer.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sources.OpcUaClient\ElpisEdgeConnect.Sources.OpcUaClient.csproj" />
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Sources.Melsec\ElpisEdgeConnect.Sources.Melsec.csproj" />
    <ProjectReference Include="..\ElpisEdgeConnect.MockAdapters\ElpisEdgeConnect.MockAdapters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MQTTnet client used by the FOCAS2→MQTT end-to-end scenario to subscribe
      and verify what the sink publishes. Version must match the one used by
      ElpisEdgeConnect.Sinks.Mqtt to avoid binding-redirect headaches.
    -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <!--
      OPC UA Client used by the OPC UA Server end-to-end test (H.3) to
      connect, browse, subscribe, and verify quality propagation against
      a running OpcUaServerSinkAdapter.

      OPC UA Server added in PR 7a (multi-protocol pilot Week 1) so an
      in-process StandardServer fixture (OpcUaClientInProcessServerFixture)
      can be hosted from test code to exercise OpcUaClientSourceAdapter
      against a real OPC stack endpoint with deterministic tag updates
      and restart semantics.

      Same dual-license posture as the production-side packages —
      GPL-2.0 for development + in-process testing, RCL via the OPC
      Foundation Corporate membership for binary distribution. Test
      projects are not redistributed to customers, so usage falls under
      the more permissive GPL-2.0 dev/test path. See
      docs/licensing/module-catalog.md § Third-party library licensing.
    -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.376.232" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.376.232" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.376.232" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Share the existing FakeFocas2Api with Integration.Tests via a linked
      compile include so we don't duplicate 300+ lines of fake plumbing.
      InternalsVisibleTo on ElpisEdgeConnect.Sources.Focas2 exposes the
      internal IFocas2Api interface this fake implements.
    -->
    <Compile Include="..\ElpisEdgeConnect.Sources.Focas2.Tests\FakeFocas2Api.cs"
             Link="TestSupport\FakeFocas2Api.cs" />
    <!--
      Mirror of the FOCAS2 pattern — link FakeMTConnectClient so the
      end-to-end scenario uses the same fake the unit tests exercise.
      InternalsVisibleTo on Sources.MTConnect exposes the internal
      IMTConnectClient interface.
    -->
    <Compile Include="..\ElpisEdgeConnect.Sources.MTConnect.Tests\FakeMTConnectClient.cs"
             Link="TestSupport\FakeMTConnectClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the pymodbus simulator Dockerfile + server alongside the tests
         so the fixture can find them via AppContext.BaseDirectory. -->
    <None Include="ModbusSimulator\Dockerfile" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ModbusSimulator\server.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
