<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ElpisEdgeConnect.Benchmarks</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Do NOT set Configuration=Release here. It overrides the default
      configuration in non-obvious ways and conflicts with solution-level
      configuration selection. BenchmarkDotNet already refuses to run in
      Debug, so the enforcement happens at runtime. Invoke with:
        dotnet run  project tests/ElpisEdgeConnect.Benchmarks -c Release
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Core\ElpisEdgeConnect.Core.csproj" />
  </ItemGroup>

</Project>
