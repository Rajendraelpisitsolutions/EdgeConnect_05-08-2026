<!--
  ElpisEdgeConnect.Benchmarks.StackCeiling: throwaway BenchmarkDotNet
  harness that runs the OPC Foundation .NET stack-ceiling measurement
  per the multi-protocol pilot expansion plan v2.1 §6 Q9 + kickoff §3
  Stream 1. The output drives the locked 30K-primary number (and
  potentially the 50K stretch) in phase2-multi-protocol-baseline.md.

  Workload sequence locked at v2.1 §6 Q9:
    1. 15K warmup for 5 minutes (Profile A reduced) — avoids cold-JIT
       and transient-allocator noise being measured as steady-state
    2. 30K sustained for 30 minutes — PRIMARY TARGET; all 7
       sustainability gates from workload-profiles.md §2 must hold
    3. 50K stretch attempt for 30 minutes — informational unless gates
       green
    4. 75K exploratory ceiling for 30 minutes — informational ONLY
       (NEVER publish as a customer-facing claim)

  Runs ONLY on the locked dedicated benchmark host per v2.1 §6 Q10
  governance rule. Shared-runner numbers from this project are
  informational only and never overwrite locked baselines.

  Reference:
    docs/sessions/2026-05-28-multi-protocol-pilot-plan-v2.1.md §1.3.1, §2.5, §6, §7
    docs/benchmarks/multi-protocol-workload-profiles.md §1, §2, §3 Profile A/B/B′
    docs/benchmarks/phase2-multi-protocol-baseline.md §1, §2, §6
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ElpisEdgeConnect.Benchmarks.StackCeiling</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Do NOT set Configuration=Release here (per Benchmarks project comment). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <!--
      OPC Foundation .NET Standard stack. Version pinned to 1.5.376.232
      to match Sinks.OpcUaServer + Sources.OpcUaClient — avoids
      double-vendoring + Microsoft.Extensions.Logging.Abstractions
      package-downgrade errors.
    -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.376.232" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.376.232" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ElpisEdgeConnect.Core\ElpisEdgeConnect.Core.csproj" />
  </ItemGroup>

</Project>
