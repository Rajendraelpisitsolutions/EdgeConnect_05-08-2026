{
  // ==========================================================================
  // Elpis EdgeConnect v2.0 — Configuration
  // Supports: MT-LINKi REST API | FOCAS2 DLL (P/Invoke) | HTTP REST (Simulator)
  // ==========================================================================

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "ElpisEdgeConnect": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/edgeconnect-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AppSettings": {
    "MaxParallelPolls": 50,
    "ChannelCapacity": 10000,
    "DefaultPollIntervalMs": 1000,
    "EnableHealthChecks": true,
    "HealthCheckPort": 8080
  },

  "MqttSettings": {
    "BrokerHost": "eremosv2.centralindia.cloudapp.azure.com",
    "BrokerPort": 5006,

    // Transport: "Tcp" (standard) or "WebSocket" (ws:// / wss://)
    "Transport": "WebSocket",
    // WebSocket path (only used when Transport = "WebSocket")
    // Common: "/mqtt" (Mosquitto/EMQX/HiveMQ), "/ws", "/"
    "WebSocketPath": "/mqtt",

    // Protocol version: "V311" (MQTT 3.1.1) or "V500" (MQTT 5.0)
    // Use "V311" for MQTT 3.x brokers — MQTTnet defaults to V500 which fails on 3.x
    "ProtocolVersion": "V311",

    "UseTls": false,
    "ClientId": "elpis-edgeconnect-menon",
    "Username": "Elpis@gmail.com",
    "Password": "Testing123$",
    "TopicPrefix": "senddatatobroker",

    // DryRun: false = publish to MQTT broker (production)
    // Set to true for testing without sending data to EREMOS
    "DryRun": false,

    // PublishMode: "Bundled" (legacy - all tags in one JSON) or "PerTag" (EREMOS - one topic per tag)
    "PublishMode": "PerTag",
    // EremosTopicPrefix: topic prefix for PerTag mode → {prefix}/{machineId}/{tagName}
    "EremosTopicPrefix": "eremos/demo/cnc",

    "QualityOfServiceLevel": 1,
    "CleanSession": false,
    "KeepAliveSeconds": 30,
    "ReconnectDelayMs": 5000,
    "MaxPendingMessages": 5000,
    "PublishBatchSize": 100,
    "PublishBatchIntervalMs": 250,
    "CaCertificatePath": "",
    "ClientCertificatePath": "",
    "ClientCertificatePassword": ""
  },

