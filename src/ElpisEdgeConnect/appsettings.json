    // =========================================================================
    // FOCAS2 DLL — ENABLED for testing
    // UPDATE the IpAddress below to your CNC controller's IP
    // REQUIRES: Fwlib64.dll in the app directory or on the system PATH
    // =========================================================================
    {
      "MachineId": "Jyoti17CNC",
      "MachineName": "Jyoti 17 CNC",
      "DeviceId": "Dev_Jyoti17CNC",
      "DeviceName": "Jyoti17CNC",
      "DataSourceType": "Focas2Dll",

      "Focas2": {
        "IpAddress": "192.168.2.34",
        "Port": 8193,
        "TimeoutSeconds": 10,
        "DllPath": "",
        "KeepAlive": false
      },

      "PollIntervalMs": 5000,
      "Enabled": true,
      // MaxConsecutiveErrors: auto-disable after N consecutive failures
      // Protects CNC from connection slot exhaustion (FOCAS2 has only 5-10 slots)
      // Set to 0 to disable auto-disable. Default: 3
      // G342 (0i-TF Plus) needs multiple handle attempts — 3 is too aggressive
      "MaxConsecutiveErrors": 10,
      "Tags": [ "mill", "bay-1", "focas2" ],
      "DataPoints": [
        "Program/MainProgram",
        "Program/RunningStatus",
        "Axes/Position/Absolute",
        "Axes/Position/Machine",
        "Axes/FeedRate",
        "Spindle/Speed",
        "Spindle/Load",
        "Alarms/Active",
        "CycleTime",
        "PartsCount"
      ],

      // MT-LINKi compatible tags are collected automatically when
      // DataSourceType = "Focas2Dll". No need to list them in DataPoints —
      // they are always collected via FOCAS2 diagnostic/PMC reads and
      // published using the same tag names as MT-LINKi.
      // Tags collected: CncState_path1_CNC, Mode_path1_CNC, Disconnect_CNC,
      //   MainProgram_path1_CNC, ActProgram_path1_CNC, PartsNum_path1_CNC,
      //   MainComment/ActComment, SigCUT/SigSBK/SigDM00/SigDM01/SigMDRN,
      //   CncWarning, CncFan1-4Status, CncBatLow, ApcBat, IndBat, SpdBat,
      //   ServoTemp, PulseCoderTemp, ServoLeakResist, SpindleTemp,
      //   SpindleLeakResist, SpindleTotalRev, and all fan statuses.
      "MtLinkiCompatTags": true
    },

