<!--
  ElpisEdgeConnect.Sources.MTConnect: MTConnect source adapter implementing
  ISourceAdapter. Polls the /current endpoint of an MTConnect Agent over
  HTTP, parses the XML response, and emits canonical data points.

  MTConnect is an open, royalty-free standard (no native DLL required).
  Works with any CNC that exposes an MTConnect Agent: Brother, Mazak,
  Okuma, DMG Mori, Haas, Makino, Doosan, and more.

  Reference: PHASE2_ENTRY.md Phase 2 adapter list; ARCHITECTURE_BLUEPRINT.md §4.2
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ElpisEdgeConnect.Sources.MTConnect</RootNamespace>
    <AssemblyName>ElpisEdgeConnect.Sources.MTConnect</AssemblyName>
    <Description>MTConnect source adapter for Elpis EdgeConnect — HTTP/XML-based CNC data collection</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1822;CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ElpisEdgeConnect.Sources.MTConnect.Tests" />
    <InternalsVisibleTo Include="ElpisEdgeConnect.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElpisEdgeConnect.Core\ElpisEdgeConnect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

</Project>
