@*
    PostUpgradeNotice — one-time popup shown after the application is upgraded
    to a new version. Detects the upgrade by comparing the running assembly
    version against the last version this browser saw (localStorage). On a real
    version change, if the license is not valid it tells the operator the app
    continues in Demo Mode (expired → "renew", never-licensed → "activate").

    Rendered once from MainLayout. Never throws into the circuit.
*@
@using System.Net.Http.Json
@using ElpisEdgeConnect.Management.Api
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject HttpClient HttpClient

@code {
    private static readonly string CurrentVersion =
        typeof(PostUpgradeNotice).Assembly.GetName().Version?.ToString(3) ?? "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // Show the demo-mode notice at most ONCE per version per browser. We
            // key off a "notified" marker rather than a previous-version marker so
            // it also fires on the very upgrade that introduces this feature — the
            // prior build never recorded a version, so a previous-version compare
            // would (wrongly) stay silent on the first 1.x -> 1.3 upgrade.
            var notifiedFor = await JS.InvokeAsync<string?>("localStorage.getItem", "ec.demoNoticeVersion")
                .ConfigureAwait(false);
            if (string.Equals(notifiedFor, CurrentVersion, StringComparison.Ordinal))
            {
                return; // already shown for this running version
            }

            LicenseStatusDto? status = null;
            try
            {
                status = await HttpClient.GetFromJsonAsync<LicenseStatusDto>("/api/license/status")
                    .ConfigureAwait(false);
            }
            catch
            {
                // If we can't read license state, don't guess — try again next load.
                return;
            }

            // Record that this version has been handled so the popup shows once,
            // whether or not we end up displaying it.
            await JS.InvokeVoidAsync("localStorage.setItem", "ec.demoNoticeVersion", CurrentVersion)
                .ConfigureAwait(false);

            // Licensed and valid → no demo-mode notice needed.
            if (status is null || status.IsValid)
            {
                return;
            }

            var isExpired = string.Equals(status.Status, "Expired", StringComparison.OrdinalIgnoreCase);
            var (title, message) = isExpired
                ? ("License expired",
                   "The license has expired. The application will continue to run in Demo Mode "
                       + "until the license is renewed.")
                : ("Demo Mode",
                   "The application will continue to run in Demo Mode until a license is activated.");

            await DialogService.ShowMessageBox(title, message, yesText: "OK").ConfigureAwait(false);
        }
        catch
        {
            // A notice must never break the app — swallow interop/timing errors.
        }
    }
}
