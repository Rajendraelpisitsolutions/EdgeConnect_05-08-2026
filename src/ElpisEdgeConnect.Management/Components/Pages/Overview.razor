@*
    Overview — the Day-1 landing page. Every commissioning session
    starts here: at-a-glance status for every route, every source,
    every sink. Live updates via Blazor Server.

    Visual reference: KepServer's "Channels" view and Matrikon
    Explorer's tree dashboard — but cleaner, with real status dots,
    no per-license clutter, no Windows-95 chrome.

    Reference: docs/PHASE4_EXECUTION_PLAN.md Milestone M.1a
*@
@page "/"
@inject HttpClient HttpClient
@implements IAsyncDisposable

<PageTitle>Overview · Connectivity Studio</PageTitle>

@* The heading sits outside the grid so it can pin to the top of the scroll
   region like every other page. Inside a MudItem it could only ever stick
   within that one grid cell, which scrolls away with the rest of the row. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4 page-heading">
    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Medium" Color="Color.Primary" />
    <div>
        <MudText Typo="Typo.h5">Overview</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            The health of every route at a glance. Start here — anything that needs
            you is called out at the top, before the per-route detail.
        </MudText>
    </div>
    <MudSpacer />
    <MudChip T="string" Size="Size.Small"
             Icon="@(FeedStale ? Icons.Material.Filled.Warning : Icons.Material.Filled.Schedule)"
             Color="@(FeedStale ? Color.Warning : Color.Default)" Variant="Variant.Text"
             title="@LastUpdatedTitle"
             data-testid="overview-last-updated">
        @LastUpdatedLabel
    </MudChip>
</MudStack>

<MudGrid>
    <MudItem xs="12">
        @* The verdict line: the one thing the operator must read first —
           "is anything broken right now?". Everything below it is detail.
           Colour is always paired with an icon and a word. *@
        @if (_routes is { Length: > 0 })
        {
            @* No mt-3: that separated the verdict from the heading back when
               both lived in this grid cell. The heading is its own pinned band
               now and supplies that gap itself. *@
            <MudPaper Class="pa-3 mb-4" Elevation="0" Style="@VerdictStyle"
                      data-testid="overview-verdict">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@VerdictIcon" Color="@VerdictColor" Size="Size.Medium" aria-hidden="true" />
                    <div style="flex-grow:1; min-width:0;">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:650; line-height:1.25;">
                            @VerdictHeadline
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">
                            @VerdictNextStep
                        </MudText>
                    </div>
                    @if (BrokenCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                 Icon="@Icons.Material.Filled.Error"
                                 data-testid="overview-broken-count">
                            @BrokenCount broken
                        </MudChip>
                    }
                    @if (AttentionCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                                 Icon="@Icons.Material.Filled.Warning"
                                 data-testid="overview-attention-count">
                            @AttentionCount need attention
                        </MudChip>
                    }
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-4">
                Live view of every configured route. Status refreshes on its own —
                you do not need to reload the page.
            </MudText>
        }
        @* ---- Configuration-faults inline strip (M.P2.1 phase 3b) ---- *@
        @* Visible only when faults are registered. Tiny — operators *@
        @* who land on /overview should NOTICE without being shouted *@
        @* at. Full detail lives on /diagnostics. *@
        @if (_faultCount > 0)
        {
            <MudPaper Class="pa-2 mb-4" Elevation="0"
                      Style="border:1px solid var(--mud-palette-warning); background:rgba(245,158,11,0.06);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem"
                             Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.body2">
                        @_faultCount configuration fault@(_faultCount == 1 ? "" : "s") —
                        <MudLink Href="/diagnostics" Underline="Underline.Hover" Color="Color.Warning">
                            see Diagnostics
                        </MudLink>
                    </MudText>
                </MudStack>
            </MudPaper>
        }
    </MudItem>

    @* A failed poll must never blank the board. Show the failure, the next
       step, and keep the last known cards below it. *@
    @if (_loadError is not null)
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined"
                      data-testid="overview-load-error">
                <MudText Typo="Typo.body2" Style="font-weight:650;">
                    Cannot reach the gateway service — this page is not live.
                </MudText>
                <MudText Typo="Typo.caption" Class="d-block mt-1">
                    Next: check the EdgeConnect service is running, then retry. Any routes
                    shown below are the last state received (@LastKnownAgo) and may be
                    out of date.
                </MudText>
                <MudText Typo="Typo.caption" Class="d-block mt-1" Style="opacity:0.75;">
                    Reported: @_loadError
                </MudText>
                <MudButton Class="mt-2" Size="Size.Small"
                           Variant="Variant.Filled" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@(() => RefreshAsync())"
                           Style="text-transform:none;"
                           data-testid="overview-retry">
                    Retry now
                </MudButton>
            </MudAlert>
        </MudItem>
    }

    @if (_routes is null && _loadError is null)
    {
        <MudItem xs="12">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                Loading routes…
            </MudText>
        </MudItem>
    }
    else if (_routes is { Length: 0 })
    {
        <MudItem xs="12">
            <MudPaper Class="pa-8" Elevation="0" Style="border:1px dashed var(--mud-palette-lines-default);"
                      data-testid="overview-empty-state">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Large"
                             Color="Color.Primary" />
                    <MudText Typo="Typo.h5">Get started</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Style="max-width:560px;">
                        EdgeConnect is configured but no data flow is wired yet. <strong>Connect a device</strong>
                        sets up your first source, destination, and route in one guided ceremony.
                    </MudText>
                    <MudButton Href="/onboard"
                               Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                               Style="text-transform:none;"
                               data-testid="overview-empty-state-connect">
                        Connect a device
                    </MudButton>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Already have a source / destination configured?
                        <MudLink Href="/routes/new" Underline="Underline.Hover">Wire a route directly →</MudLink>
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
    else if (_routes is not null)
    {
        @* Broken first, then anything needing attention, then healthy —
           trouble must be visible without scrolling. OrderBy is stable, so
           routes keep their API order inside each band. *@
        @foreach (var route in _routes.OrderBy(HealthRank))
        {
            <MudItem xs="12" sm="6" lg="4" @key="route.RouteId">
                <RouteCard Route="@route" />
            </MudItem>
        }
    }
</MudGrid>

@code {
    private RouteSummaryDto[]? _routes;
    private string? _loadError;
    private DateTime _lastUpdated = DateTime.MinValue;
    private int _faultCount;
    private CancellationTokenSource? _cts;
    private Task? _pollLoop;

    // _lastUpdated is UTC so OperatorFormat renders it as "2 min ago" with
    // the absolute local time on hover. A page that silently stops polling
    // is worse than one that says so.
    private string LastUpdatedLabel => _lastUpdated == DateTime.MinValue
        ? "Waiting for first update"
        : FeedStale
            ? $"Not updating — last update {OperatorFormat.Ago(_lastUpdated)}"
            : $"Updated {OperatorFormat.Ago(_lastUpdated)}";

    private string LastUpdatedTitle => _lastUpdated == DateTime.MinValue
        ? "No update received yet"
        : OperatorFormat.Absolute(_lastUpdated);

    private string LastKnownAgo => _lastUpdated == DateTime.MinValue
        ? "never"
        : OperatorFormat.Ago(_lastUpdated);

    // The poll runs every 2s; 30s without one means the page is lying.
    private bool FeedStale => _lastUpdated != DateTime.MinValue
        && OperatorFormat.IsStale(_lastUpdated, TimeSpan.FromSeconds(30));

    private int TotalRoutes => _routes?.Length ?? 0;
    private int BrokenCount => _routes?.Count(RouteIsBroken) ?? 0;
    private int AttentionCount => _routes?.Count(RouteNeedsAttention) ?? 0;

    private string VerdictHeadline => BrokenCount > 0
        ? $"{BrokenCount} of {TotalRoutes} route{(TotalRoutes == 1 ? "" : "s")} broken — fix these first"
        : AttentionCount > 0
            ? $"{AttentionCount} of {TotalRoutes} routes need attention"
            : $"All {TotalRoutes} routes are running";

    private string VerdictNextStep => BrokenCount > 0
        ? "Broken routes are listed first below. Each card names what failed, when it started, and what to check."
        : AttentionCount > 0
            ? "Data is still moving, but a destination or buffer is unhealthy. Those routes are listed first below."
            : "Every route has a healthy source and destination. Nothing needs you right now.";

    private string VerdictIcon => BrokenCount > 0
        ? Icons.Material.Filled.Error
        : AttentionCount > 0 ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle;

    private Color VerdictColor => BrokenCount > 0
        ? Color.Error
        : AttentionCount > 0 ? Color.Warning : Color.Success;

    private string VerdictStyle => BrokenCount > 0
        ? "border:1px solid var(--mud-palette-error); background:rgba(220,38,38,0.06);"
        : AttentionCount > 0
            ? "border:1px solid var(--mud-palette-warning); background:rgba(245,158,11,0.06);"
            : "border:1px solid var(--mud-palette-lines-default);";

    // Health banding. RouteSummaryDto carries no rollup health field, so the
    // page derives it from the same signals RouteCard shows. An error older
    // than the stale window is history and must not push a route up the grid.
    private static bool IsLiveError(DateTime? utc) =>
        utc is not null && !OperatorFormat.IsStale(utc);

    private static bool RouteIsBroken(RouteSummaryDto r) =>
        r.StateName is "Stopped" or "Faulted" or "Failed"
        || IsLiveError(r.LastErrorAtUtc)
        || IsLiveError(r.Source?.LastErrorAtUtc)
        || r.Sinks.Any(s => IsLiveError(s.LastErrorAtUtc));

    private static bool RouteNeedsAttention(RouteSummaryDto r) =>
        !RouteIsBroken(r)
        && (r.StateName is "Degraded"
            || r.Source?.StateName is "Degraded"
            || (r.Buffer?.TotalDropped ?? 0) > 0
            || r.Sinks.Any(s => s.IsDegraded || s.IsDraining));

    private static int HealthRank(RouteSummaryDto r) =>
        RouteIsBroken(r) ? 0 : RouteNeedsAttention(r) ? 1 : 2;

    protected override async Task OnInitializedAsync()
    {
        // Synchronous SSR pre-render: fetch once so the static-rendered
        // HTML has data. Don't start the polling loop here — that
        // happens after first render on the interactive circuit.
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Now we're inside the interactive Blazor Server circuit. Start
        // the polling loop; it'll be cleanly cancelled when the
        // component is disposed.
        _cts = new CancellationTokenSource();
        _pollLoop = PollLoopAsync(_cts.Token);
        await Task.CompletedTask;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAsync(ct);
            }
        }
        catch (OperationCanceledException)
        {
            // expected on dispose
        }
    }

    private async Task RefreshAsync(CancellationToken ct = default)
    {
        try
        {
            var routes = await HttpClient.GetFromJsonAsync<RouteSummaryDto[]>("/api/v1/routes", ct);
            // Race-window guard: between awaits, navigation may have started
            // disposing this component. Bail BEFORE InvokeAsync — otherwise
            // we queue a render on a renderer that's about to vanish, and
            // the queued render hits ObjectDisposedException inside
            // ArrayBuilder.GrowBuffer (not catchable here — it happens on
            // Blazor's dispatcher after our await returns).
            if (ct.IsCancellationRequested) return;
            _routes = routes ?? Array.Empty<RouteSummaryDto>();
            _loadError = null;
            // UTC, not local: OperatorFormat.Ago subtracts from DateTime.UtcNow,
            // so a local timestamp here would be wrong by the site's offset.
            _lastUpdated = DateTime.UtcNow;

            // Configuration-faults strip — best-effort. Old hosts without
            // the registry endpoint silently report zero faults and the
            // strip stays hidden. The events surface itself is the
            // canonical place to read details (see /diagnostics).
            try
            {
                var faults = await HttpClient.GetFromJsonAsync<ConfigurationFaultDto[]>(
                    "/api/v1/diagnostics/configuration-faults", ct);
                _faultCount = faults?.Length ?? 0;
            }
            catch
            {
                // Leave the previous count in place rather than flicker.
            }

            if (ct.IsCancellationRequested) return;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Token cancelled mid-await — dispose in flight; bail.
        }
        catch (ObjectDisposedException)
        {
            // Component scope torn down between ticks; let the loop exit.
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested) return;
            _loadError = ex.Message;
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { /* ignore */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _cts?.Cancel();
            if (_pollLoop is not null)
            {
                await _pollLoop;
            }
        }
        catch
        {
            // best-effort
        }
        finally
        {
            _cts?.Dispose();
        }
    }
}
