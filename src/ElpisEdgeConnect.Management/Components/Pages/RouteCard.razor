@*
    One route's status card on the Overview grid.

    Visual rules (locked):
       * Status dot is the focal point — green/yellow/red, large.
       * Route id is the headline.
       * Source + protocol + state on one line.
       * Sink(s) each get a line with their adapter state + degraded
         badge + active-session count when applicable.
       * Buffer depth on a small linear gauge — NOT a chart. Per the
         "no analytics in Studio" rule (locked in M plan review).
       * Last-error timestamp + code shown when present.

    Reference: docs/PHASE4_EXECUTION_PLAN.md Milestone M.1a
*@
@inject IDialogService DialogService

@if (Route is not null)
{
    var trouble = BuildTrouble();

    <MudPaper Elevation="1" Class="pa-4 route-card" Style="@CardStyle(trouble)"
              data-testid="route-card">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            @* Shape as well as colour: a green dot and a red dot are the same
               dot to a colour-blind operator under bad lighting. *@
            <MudIcon Icon="@StateIcon" Color="@StateColor" Size="Size.Medium" aria-hidden="true" />
            <div style="flex-grow:1; overflow:hidden;">
                <MudText Typo="Typo.caption"
                         Style="display:block; opacity:0.55; font-weight:600; letter-spacing:0.04em; line-height:1;">
                    ROUTE
                </MudText>
                <MudText Typo="Typo.h6" Style="overflow:hidden; text-overflow:ellipsis; line-height:1.2;">
                    @Route.RouteId
                </MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Color="@StateColor"
                     Variant="@(trouble is null ? Variant.Outlined : Variant.Filled)"
                     data-testid="route-state-chip">
                @Route.StateName
            </MudChip>
        </MudStack>


        @if (Route.Source is not null)
        {
            <div class="d-flex align-center mb-2" style="gap:4px;">
                <MudLink Href="@($"/sources/{Route.Source.SourceInstanceId}")"
                         Underline="Underline.None"
                         Color="Color.Inherit"
                         Style="flex-grow:1; overflow:hidden;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Input" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Style="flex-grow:1;">
                            <span style="opacity:0.55; font-weight:600;">Source:</span>
                            <strong>@Route.Source.SourceInstanceId</strong>
                            <span style="opacity:0.6;"> · @Route.Source.ProtocolName</span>
                        </MudText>
                    </MudStack>
                </MudLink>
                @* Per-source diagnostic log: view + opt-in enable (records
                   connect/disconnect + data reads to logs\<source>.txt).

                   Sits BEFORE the state chip. It used to come after it, which
                   made this the only row whose state chip was not flush with
                   the card's right edge — the route chip above and the
                   destination chip below both are, so the source one looked
                   knocked out of line. *@
                <MudTooltip Text="Source log — view / enable logging">
                    <MudIconButton Icon="@Icons.Material.Filled.Article"
                                   Size="Size.Small" Color="Color.Default"
                                   OnClick="@(() => OpenLog(Route.Source.SourceInstanceId))"
                                   aria-label="@($"Open connection log for {Route.Source.SourceInstanceId}")"
                                   data-testid="source-log-button" />
                </MudTooltip>
                @* Outside the link now, so the three state chips line up in one
                   column. Losing link behaviour on the chip costs nothing — the
                   whole row is still a link to the source. *@
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@SourceColor">
                    @Route.Source.StateName
                </MudChip>
            </div>
            @* Counters need a frame: how many, and how fresh. A device that is
               "Running" but has sent nothing for 20 minutes is not fine. *@
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-7 mb-2"
                     Style="display:block;" data-testid="source-freshness">
                @OperatorFormat.Count(Route.Source.PointsObserved) values read since start
                @if (Route.Source.LastPointAtUtc is { } lastPt)
                {
                    <span title="@OperatorFormat.Absolute(lastPt)">· last value @OperatorFormat.Ago(lastPt)</span>
                }
                else
                {
                    <span>· no values received yet</span>
                }
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Input" Size="Size.Small" Class="mr-1" />
                No source attached
            </MudText>
        }

        <MudDivider Class="my-2" />

        @if (Route.Sinks.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Small" Class="mr-1" />
                No destinations attached
            </MudText>
        }
        else
        {
            @foreach (var sink in Route.Sinks)
            {
                <MudLink Href="@($"/sinks/{sink.SinkInstanceId}")"
                         Underline="Underline.None"
                         Color="Color.Inherit"
                         Class="d-block">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Style="flex-grow:1;">
                            <span style="opacity:0.55; font-weight:600;">Destination:</span>
                            <strong>@sink.SinkInstanceId</strong>
                            @if (!string.IsNullOrEmpty(sink.ProtocolName))
                            {
                                <span style="opacity:0.6;"> · @sink.ProtocolName</span>
                            }
                        </MudText>
                        @if (sink.ActiveSessionCount is { } n)
                        {
                            <MudTooltip Text="Clients currently connected to this destination">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.People">
                                    @n connected
                                </MudChip>
                            </MudTooltip>
                        }
                        @if (sink.IsDraining)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                     Variant="Variant.Filled"
                                     Icon="@Icons.Material.Filled.Sync">Catching up</MudChip>
                        }
                        @if (sink.IsDegraded)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                     Variant="Variant.Filled"
                                     Icon="@Icons.Material.Filled.Warning">Not delivering</MudChip>
                        }
                        else if (sink.AdapterStateName is { } stateName)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@SinkColor(sink)"
                                     Variant="Variant.Outlined">@stateName</MudChip>
                        }
                    </MudStack>
                </MudLink>
            }
        }

        @if (Route.Buffer is not null)
        {
            <MudDivider Class="my-2" />
            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small"
                         Color="Color.Secondary" aria-hidden="true" />
                @* The buffer DTO carries no capacity, so never claim "N of M".
                   Frame the number by what it means for the operator instead. *@
                <MudText Typo="Typo.caption" Style="flex-grow:1; min-width:0;"
                         data-testid="route-buffer">
                    @* One line. The buffer-mode clause is the same sentence on
                       every card on the page, so inline it was noise repeated
                       per route — it belongs on hover. *@
                    <span style="display:block;" title="@OperatorFormat.BufferModeLabel(Route.Buffer.Mode)">
                        <strong>@OperatorFormat.Count(Route.Buffer.CurrentDepth)</strong> waiting
                        <span style="opacity:0.65;">
                            @* The @if needs whitespace before it. Written as
                               "delivered@if (...)" Razor never transitions into
                               code and prints the block as literal text. *@
                            · @OperatorFormat.Count(Route.Buffer.TotalDrained) delivered
                            @if (Route.Buffer.SizeBytes > 0)
                            {
                                <text>· @OperatorFormat.Bytes(Route.Buffer.SizeBytes) on disk</text>
                            }
                        </span>
                    </span>
                    @if (Route.Buffer.TotalDropped > 0)
                    {
                        <span style="display:block; color:var(--mud-palette-error); font-weight:600;"
                              data-testid="route-buffer-loss">
                            Data lost: @OperatorFormat.Count(Route.Buffer.TotalDropped) messages were dropped
                            because the buffer overflowed. Fix the destination, then watch this stop rising.
                        </span>
                    }
                    else if (Route.Buffer.CurrentDepth > 0 && Route.Buffer.TotalDrained == 0)
                    {
                        <span style="display:block; color:var(--mud-palette-warning); font-weight:600;"
                              data-testid="route-buffer-wedged">
                            Nothing has been delivered yet — the queue is only growing.
                            The destination is not accepting data.
                        </span>
                    }
                </MudText>
            </MudStack>
        }

        @* An error inside the live window is a fault happening NOW. Anything
           older degrades to a quiet, uncoloured note — a 19-minute-old blip
           must never read as a live outage. *@
        @* One fault line at the foot of the card. A broken card is otherwise the
           same shape as a healthy one — same rows, same height — so scanning a
           board of routes does not mean re-reading a different layout each time.

           The card used to open with a red banner AND close with a raw adapter
           dump, which said the same thing twice and tripled the card's height.
           The banner is gone; the plain sentence below replaces both, and the
           adapter's own words stay one click away for whoever needs them. *@
        @if (Route.Source?.LastErrorAtUtc is { } errAt && !OperatorFormat.IsStale(errAt))
        {
            var fault = PlainFault(Route.Source?.LastErrorCode, Route.Source?.LastErrorMessage);
            <div class="route-fault" data-testid="route-source-error-live">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small"
                         Color="Color.Error" aria-hidden="true" />
                <div style="min-width:0;">
                    <span class="route-fault-headline">@fault.What</span>
                    <span class="route-fault-step">@fault.Next</span>
                    <details class="route-error-detail">
                        <summary>
                            <code>@(Route.Source?.LastErrorCode ?? "Error")</code>
                            <span style="opacity:.7;" title="@OperatorFormat.Absolute(errAt)">
                                · since @OperatorFormat.Ago(errAt)
                            </span>
                        </summary>
                        @if (Route.Source?.LastErrorMessage is { } msg)
                        {
                            <div class="route-error-detail-body">@msg</div>
                        }
                    </details>
                </div>
            </div>
        }
        @if (Route.Source?.LastErrorAtUtc is { } oldErrAt && OperatorFormat.IsStale(oldErrAt))
        {
            <div class="mt-3 pa-2" data-testid="route-source-error-stale"
                 style="border:1px solid var(--mud-palette-lines-default); border-radius:6px;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small"
                             Style="vertical-align:text-bottom;" aria-hidden="true" />
                    Last source error —
                    <span title="@OperatorFormat.Absolute(oldErrAt)">@OperatorFormat.Ago(oldErrAt)</span>
                    · @(Route.Source?.LastErrorCode ?? "Error"). Nothing new since; no action
                    needed unless it repeats.
                </MudText>
            </div>
        }

        @* Same rule for destinations: a live send failure is an alert, an older
           one is history. Before this, a destination that recovered 20 minutes
           ago still rendered as a red live fault. *@
        @foreach (var sink in Route.Sinks)
        {
            @if (sink.LastErrorAtUtc is { } sinkErrAt && !OperatorFormat.IsStale(sinkErrAt))
            {
                @* Same split as the source block above: the banner at the top of
                   the card carries the verdict and the next step, so this one
                   carries only what a support engineer needs. *@
                var sf = PlainFault(sink.LastErrorCode, sink.LastErrorMessage, isSink: true);
                <div class="route-fault" data-testid="route-sink-error-live">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small"
                             Color="Color.Error" aria-hidden="true" />
                    <div style="min-width:0;">
                        <span class="route-fault-headline">@sf.What</span>
                        <span class="route-fault-step">@sf.Next</span>
                        <details class="route-error-detail">
                            <summary>
                                <code>@(sink.LastErrorCode ?? "Error")</code>
                                <span style="opacity:.7;" title="@OperatorFormat.Absolute(sinkErrAt)">
                                    · since @OperatorFormat.Ago(sinkErrAt)
                                </span>
                            </summary>
                            @if (sink.LastErrorMessage is { } sinkMsg)
                            {
                                <div class="route-error-detail-body">@sinkMsg</div>
                            }
                        </details>
                    </div>
                </div>
            }
            @if (sink.LastErrorAtUtc is { } oldSinkAt && OperatorFormat.IsStale(oldSinkAt))
            {
                <div class="mt-2 pa-2" data-testid="route-sink-error-stale"
                     style="border:1px solid var(--mud-palette-lines-default); border-radius:6px;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                 Style="vertical-align:text-bottom;" aria-hidden="true" />
                        Last error on @sink.SinkInstanceId —
                        <span title="@OperatorFormat.Absolute(oldSinkAt)">@OperatorFormat.Ago(oldSinkAt)</span>
                        · @(sink.LastErrorCode ?? "Error"). Nothing new since.
                    </MudText>
                </div>
            }
        }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public RouteSummaryDto? Route { get; set; }

    private Task OpenLog(string sourceId)
    {
        var parameters = new DialogParameters<SourceLogDialog>
        {
            { x => x.SourceId, sourceId },
        };
        return DialogService.ShowAsync<SourceLogDialog>(
            $"Source log — {sourceId}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private Color StateColor => (Route?.StateName) switch
    {
        "Running" => Color.Success,
        "Degraded" => Color.Warning,
        "Stopped" or "Faulted" or "Failed" => Color.Error,
        _ => Color.Default,
    };

    private Color SourceColor => (Route?.Source?.StateName) switch
    {
        "Running" => Color.Success,
        "Degraded" => Color.Warning,
        "Stopped" or "Failed" or "Faulted" => Color.Error,
        _ => Color.Default,
    };

    private static Color SinkColor(RouteSinkSummaryDto s) => s.AdapterStateName switch
    {
        "Running" => Color.Success,
        "Degraded" => Color.Warning,
        "Stopped" or "Failed" or "Faulted" => Color.Error,
        _ => Color.Default,
    };

    // Shape as well as colour for the headline status dot — a green dot and
    // a red dot are the same dot to a colour-blind operator.
    private string StateIcon => (Route?.StateName) switch
    {
        "Running" => Icons.Material.Filled.CheckCircle,
        "Degraded" => Icons.Material.Filled.Warning,
        "Stopped" => Icons.Material.Filled.PauseCircleOutline,
        "Faulted" or "Failed" => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.HelpOutline,
    };

    // One verdict per card: what is wrong, and what to do next.
    /// <summary>A fault in words the person standing at the machine can act on.</summary>
    private sealed record PlainFaultText(string What, string Next);

    /// <summary>
    /// Turns an adapter's error code and message into one plain sentence plus one
    /// next step.
    ///
    /// Matched on the code FAMILY, not the exact code: every protocol names its
    /// failures differently (MODBUS.CONNECT_FAILED, FOCAS2.COLLECT_ERROR,
    /// OPCUA.BADSESSIONCLOSED) but the operator's action is the same for all of
    /// them — a device that cannot be reached is a cable, a power switch or an
    /// address, whichever protocol reported it. Anything unrecognised falls
    /// through to a neutral sentence rather than a guess; the adapter's own
    /// words are always one click away underneath.
    /// </summary>
    private static PlainFaultText PlainFault(string? code, string? message, bool isSink = false)
    {
        var c = (code ?? string.Empty).ToUpperInvariant();
        var m = (message ?? string.Empty).ToLowerInvariant();
        var thing = isSink ? "destination" : "device";

        // A missing native driver is a gateway problem, not a plant problem —
        // no amount of checking cables will fix it, so say so plainly.
        if (m.Contains("could not load") || m.Contains(".dll") || m.Contains(".so"))
        {
            return new PlainFaultText(
                "A driver file this protocol needs is missing on the gateway.",
                "Nothing is wrong with the machine. Send this to Elpis support — the file has to be installed beside EdgeConnect.");
        }

        if (c.Contains("AUTH") || c.Contains("UNAUTHORIZED") || c.Contains("CREDENTIAL")
            || m.Contains("unauthorized") || m.Contains("bad username") || m.Contains("not authorized"))
        {
            return new PlainFaultText(
                $"The {thing} refused the login.",
                "Check the username and password in Edit, then save.");
        }

        if (c.Contains("TIMEOUT") || m.Contains("timed out") || m.Contains("timeout"))
        {
            return new PlainFaultText(
                $"The {thing} did not answer in time.",
                "It may be busy or on a slow link. If it repeats, raise the timeout in Edit.");
        }

        if (c.Contains("CONNECT") || c.Contains("UNREACHABLE") || c.Contains("REFUSED")
            || m.Contains("not reachable") || m.Contains("no connection")
            || m.Contains("refused") || m.Contains("broken pipe"))
        {
            return isSink
                ? new PlainFaultText(
                    "Cannot reach this destination.",
                    "Data is safe in the buffer meanwhile. Check the service is running and reachable from this gateway.")
                : new PlainFaultText(
                    "Cannot reach this device.",
                    "Check it is powered on, plugged in, and that its address has not changed.");
        }

        return isSink
            ? new PlainFaultText(
                "This destination reported an error.",
                "Data is held in the buffer. Open the detail below, or check Diagnostics.")
            : new PlainFaultText(
                "This device reported an error.",
                "Open the detail below, or open its log for the full history.");
    }

    // Only the tone survives: it colours the card's left edge and decides
    // whether the state chip is filled. The headline and next-step text this
    // used to carry are now produced by PlainFault at the point of use, so the
    // wording sits next to the error it describes instead of at the top of the
    // card describing something further down.
    private sealed record RouteTrouble(Color Tone, string Icon);

    private static string AccentCss(RouteTrouble? t) => t?.Tone switch
    {
        Color.Error => "var(--mud-palette-error)",
        Color.Warning => "var(--mud-palette-warning)",
        _ => "var(--mud-palette-lines-default)",
    };

    private static string CardStyle(RouteTrouble? t) =>
        $"height:100%; border-left:4px solid {AccentCss(t)};";

    // First match wins, most urgent first. An error older than the stale
    // window is history, not a live fault — that distinction is the point.
    private RouteTrouble? BuildTrouble()
    {
        if (Route is null) return null;
        var src = Route.Source;

        if (src?.LastErrorAtUtc is { } srcAt && !OperatorFormat.IsStale(srcAt))
        {
            return new RouteTrouble(Color.Error, Icons.Material.Filled.Error);
        }

        foreach (var s in Route.Sinks)
        {
            if (s.LastErrorAtUtc is { } sinkAt && !OperatorFormat.IsStale(sinkAt))
            {
                return new RouteTrouble(Color.Error, Icons.Material.Filled.Error);
            }
        }

        if (Route.LastErrorCode is { } routeCode)
        {
            return new RouteTrouble(Color.Error, Icons.Material.Filled.ReportProblem);
        }

        if (Route.StateName is "Stopped")
        {
            return new RouteTrouble(Color.Error, Icons.Material.Filled.PauseCircleOutline);
        }

        if (Route.StateName is "Faulted" or "Failed")
        {
            return new RouteTrouble(Color.Error, Icons.Material.Filled.ReportProblem);
        }

        if (Route.Buffer is { TotalDropped: > 0 } dropped)
        {
            return new RouteTrouble(Color.Error, Icons.Material.Filled.ReportProblem);
        }

        foreach (var s in Route.Sinks)
        {
            if (s.IsDegraded)
            {
                return new RouteTrouble(Color.Warning, Icons.Material.Filled.Warning);
            }
        }

        foreach (var s in Route.Sinks)
        {
            if (s.IsDraining)
            {
                return new RouteTrouble(Color.Info, Icons.Material.Filled.Sync);
            }
        }

        if (src?.LastPointAtUtc is { } lastPt && OperatorFormat.IsStale(lastPt))
        {
            return new RouteTrouble(Color.Warning, Icons.Material.Filled.HourglassEmpty);
        }

        if (Route.StateName is "Degraded")
        {
            return new RouteTrouble(Color.Warning, Icons.Material.Filled.Warning);
        }

        if (src?.LastErrorAtUtc is { } oldSrc)
        {
            return new RouteTrouble(Color.Default, Icons.Material.Filled.History);
        }

        foreach (var s in Route.Sinks)
        {
            if (s.LastErrorAtUtc is { } oldSink)
            {
                return new RouteTrouble(Color.Default, Icons.Material.Filled.History);
            }
        }

        return null;
    }
}
