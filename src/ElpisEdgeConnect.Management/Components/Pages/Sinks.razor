@*
    Sinks list page. MudDataGrid with sortable columns —
    operators jump here to answer "which sinks are pushing
    data right now?" and (for OPC UA) "how many SCADA/HMI
    clients are subscribed?" at a glance.

    Layout:
       * Header row with title + sink count + "Add sink" button
         (wizard lands in M.2b; greyed out for now).
       * DataGrid: instance ID · sink kind · route · state ·
         degraded? · active sessions · last error.
       * Row click → /sinks/{instanceId} for the detail view.
       * Empty state when no sinks are configured.

    Polls /api/v1/sinks every 3s via PeriodicTimer on the
    interactive Blazor Server circuit — same cadence and
    lifecycle pattern as Sources.razor (M.1b.2).
*@
@page "/sinks"
@using ElpisEdgeConnect.Management.Components.Shared
@using ElpisEdgeConnect.Management.Contracts
@using ElpisEdgeConnect.Management.Wizards
@inject HttpClient HttpClient
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>Destinations · Connectivity Studio</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4 page-heading">
    <MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Medium" Color="Color.Primary" />
    <div>
        <MudText Typo="Typo.h5">Destinations</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Every protocol adapter that pushes data out of EdgeConnect — to brokers, OPC UA clients, HTTP endpoints, or TCP listeners.
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="@(_sinks is { Length: 0 } ? Variant.Outlined : Variant.Filled)" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/destinations/new"
               Style="text-transform:none;">
        Add destination
    </MudButton>
</MudStack>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <strong>Could not load destinations.</strong> @_loadError
    </MudAlert>
}
else if (_sinks is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_sinks.Length == 0)
{
    <MudPaper Class="pa-8" Elevation="0" Style="border:1px dashed var(--mud-palette-lines-default);"
              data-testid="destinations-empty-state">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.h6">No destinations yet — data has nowhere to go</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center"
                     Style="max-width:44rem;">
                A destination is where EdgeConnect sends the data it collects: an MQTT broker, an OPC UA
                endpoint your SCADA or HMI subscribes to, or an HTTP/TCP service. Until you add one,
                anything read from a machine is discarded.
            </MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                <MudButton Href="/onboard"
                           Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.RocketLaunch"
                           Style="text-transform:none;"
                           data-testid="destinations-empty-state-connect">
                    Connect a device
                </MudButton>
                <MudTooltip Text="Add somewhere for data to go — an MQTT broker, or an OPC UA server.">
                    <MudButton Href="/destinations/new"
                               Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Add"
                               Style="text-transform:none;">
                        Add destination only
                    </MudButton>
                </MudTooltip>
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mt-1">
                <strong>Connect a device</strong> sets up source + destination + route in one flow.
            </MudText>
        </MudStack>
    </MudPaper>
}
else
{
    <MudDataGrid T="SinkListItemDto"
                 Items="@_sinks"
                 SortMode="SortMode.Multiple"
                 Filterable="true"
                 QuickFilter="@QuickFilter"
                 Dense="true"
                 Hover="true"
                 Bordered="false"
                 RowClick="@OnRowClick"
                 RowStyleFunc="@RowStyleFunc"
                 Elevation="1"
                 Class="rounded-lg">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                @_sinks.Length destination@(_sinks.Length == 1 ? "" : "s") configured
            </MudText>
            <MudSpacer />
            @* Immediate: without it @bind-Value only commits on blur, so typing
               into the box did nothing at all until focus moved elsewhere — the
               filter looked broken. The two wizard filters already set it; these
               three did not. Debounce keeps it off the keystroke path on a list
               of a few hundred rows. Clearable gives the operator the way back
               that the "no matches" panel tells them to take. *@
            <MudTextField @bind-Value="_searchText"
                          Immediate="true"
                          DebounceInterval="150"
                          Clearable="true"
                          Placeholder="Filter…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          aria-label="Filter this list"
                          Style="max-width:280px;" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Sink.SinkInstanceId" Title="Instance ID">
                <CellTemplate>
                    <MudLink Href="@($"/sinks/{context.Item.Sink.SinkInstanceId}")"
                             Underline="Underline.Hover"
                             Style="font-weight:500;">
                        @context.Item.Sink.SinkInstanceId
                    </MudLink>
                </CellTemplate>
            </PropertyColumn>
            @* ── Action column (M.2b.6.1 Locked E + H + I two-column model).
               Promoted to position 2 so the headline remediation surface is
               always visible without horizontal scroll (post-smoke UX fix). ── *@
            <TemplateColumn Title="Action" Sortable="false" Filterable="false">
                <CellTemplate>
                    @{
                        var id = context.Item.Sink.SinkInstanceId;
                        var configEnabled = ConfigEnabledFor(id);
                        var draining = context.Item.Sink.IsDraining;  // Locked I — drain-state guard
                    }
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (configEnabled is null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Default" Style="opacity:0.4;">—</MudText>
                        }
                        else if (draining)
                        {
                            <MudTooltip Text="Drain in progress. Wait for stop to complete.">
                                <span>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                               Disabled="true"
                                               Style="text-transform:none;">
                                        @(configEnabled.Value ? "Disable" : "Enable")
                                    </MudButton>
                                </span>
                            </MudTooltip>
                        }
                        else if (configEnabled.Value)
                        {
                            <MudTooltip Text="Stop publishing to this destination. Data keeps buffering and is sent when you enable it again.">
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           OnClick="@(() => OpenToggleDrawer(id, desired: false))"
                                           Style="text-transform:none;">
                                    Disable
                                </MudButton>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Start publishing to this destination. Anything buffered is drained first.">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenToggleDrawer(id, desired: true))"
                                           Style="text-transform:none;">
                                    Enable
                                </MudButton>
                            </MudTooltip>
                        }
                        @* M.2d.3 — Edit pencil alongside Enable/Disable to match
                           Sources.razor layout. stopPropagation prevents MudDataGrid
                           RowClick from intercepting the navigation. ── *@
                        <MudTooltip Text="Change where and how this destination publishes.">
                            <span @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => Nav.NavigateTo($"/destinations/{Uri.EscapeDataString(id)}/edit"))"
                                               aria-label="@($"Edit destination {id}")"
                                               data-testid="sinks-row-edit-button" />
                            </span>
                        </MudTooltip>
                        @* Delete — removes the destination; any route left with no
                           sinks after the removal is dropped too (a route must
                           dispatch to at least one sink). Audited draft → apply,
                           guarded by a confirmation dialog. *@
                        <MudTooltip Text="Delete this destination. Publishing to it stops immediately and anything still buffered for it is discarded.">
                            <span @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => ConfirmAndDeleteAsync(id))"
                                               aria-label="@($"Delete destination {id}")"
                                               data-testid="sinks-row-delete-button" />
                            </span>
                        </MudTooltip>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.SinkKind" Title="Kind">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@KindColor(context.Item.SinkKind)"
                             Style="text-transform:none;">
                        @* "opcua-server" / "mqtt" are config keys, not words an
                           operator uses. KindLabel already maps them. *@
                        @OperatorFormat.SinkKindLabel(context.Item.SinkKind)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.RouteIds.Count" Title="Routes">
                <CellTemplate>
                    @if (context.Item.RouteIds.Count == 0)
                    {
                        @* Configured but unwired — operator added the destination but no route uses it yet. *@
                        <MudTooltip Text="No route references this destination. Edit Configuration to wire it.">
                            <MudText Typo="Typo.body2" Color="Color.Default" Style="opacity:0.4;">—</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var rid in context.Item.RouteIds)
                            {
                                <MudLink Href="@($"/routes/{rid}")" Underline="Underline.Hover">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="Color.Default" Style="text-transform:none;">
                                        @rid
                                    </MudChip>
                                </MudLink>
                            }
                        </MudStack>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Sink.AdapterStateName" Title="State">
                <CellTemplate>
                    @{
                        var stateName = context.Item.Sink.AdapterStateName;
                        var tooltipText = FaultedTooltip(stateName, context.Item.Sink);
                    }
                    <MudTooltip Text="@tooltipText" Disabled="@(tooltipText is null)">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Circle"
                                     Size="Size.Small"
                                     Color="@StateColor(context.Item.Sink)" />
                            <MudText Typo="Typo.body2">@(stateName ?? "—")</MudText>
                        </MudStack>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Sink.IsDegraded" Title="Data arriving?">
                <CellTemplate>
                    @{
                        var d = context.Item.Sink;
                        var deliveryHint = DeliveryHint(d);
                    }
                    <MudStack Spacing="0" Style="min-width:180px;">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@DeliveryIcon(d)" Size="Size.Small" Color="@DeliveryColor(d)" />
                            <MudText Typo="Typo.body2" Style="font-weight:500;">@DeliveryLabel(d)</MudText>
                        </MudStack>
                        @if (!string.IsNullOrEmpty(deliveryHint))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height:1.35;">
                                @deliveryHint
                            </MudText>
                        }
                    </MudStack>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Sink.ActiveSessionCount" Title="Connected clients">
                <CellTemplate>
                    @if (context.Item.Sink.ActiveSessionCount is { } n)
                    {
                        <MudTooltip Text="@SessionHint(n)">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@(n == 0 ? Icons.Material.Filled.PersonOff : Icons.Material.Filled.People)"
                                         Size="Size.Small"
                                         Color="@(n == 0 ? Color.Warning : Color.Secondary)" />
                                <MudText Typo="Typo.body2">@OperatorFormat.Count(n) client@(n == 1 ? "" : "s")</MudText>
                            </MudStack>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="This protocol does not report client connections — an MQTT broker owns its subscribers.">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">not reported</MudText>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Sink.LastErrorCode" Title="Last error">
                <CellTemplate>
                    @{
                        var e = context.Item.Sink;
                        var errAt = e.LastErrorAtUtc;
                        var errStale = errAt is not null && OperatorFormat.IsStale(errAt);
                    }
                    @if (e.LastErrorCode is { } code)
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"
                                  title="@OperatorFormat.Absolute(errAt)">
                            <MudIcon Icon="@(errStale ? Icons.Material.Filled.History : Icons.Material.Filled.Error)"
                                     Size="Size.Small"
                                     Color="@(errStale ? Color.Default : Color.Error)" />
                            @* Parenthesised on purpose: a bare @@code is the Razor
                               directive, not the local variable. *@
                            <MudText Typo="Typo.body2" Color="@(errStale ? Color.Secondary : Color.Error)">@(code)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@OperatorFormat.Ago(errAt)</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">none</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <NoRecordsContent>
            @* Without this, filtering to zero rows leaves a bare grid with no
               explanation and no way back. *@
            <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="pa-6"
                      data-testid="sinks-no-matches">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Default" />
                <MudText Typo="Typo.body2">No destination matches <strong>@_searchText</strong>.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Next: clear the filter box to see all @(_sinks?.Length ?? 0) destinations.
                </MudText>
            </MudStack>
        </NoRecordsContent>
    </MudDataGrid>
}

@* Confirm drawer (M.2b.6.1). *@
<EnableDisableConfirmDrawer Model="@_drawerModel"
                            OnPrimaryAction="@OnDrawerApply"
                            OnCancelAction="@OnDrawerCancel" />

@code {
    private SinkListItemDto[]? _sinks;
    private string? _loadError;
    private string _searchText = string.Empty;
    private CancellationTokenSource? _cts;
    private Task? _pollLoop;

    // M.2b.6.1 — config + drawer state. Same shape as Sources.razor.
    private GatewayConfiguration? _currentConfig;
    private string? _currentVersion;
    private readonly EnableDisableConfirmDrawerModel _drawerModel = new();
    private string? _focusedRowId;

    protected override async Task OnInitializedAsync()
    {
        ReadFocusQueryParam();
        await RefreshAsync();
    }

    private void ReadFocusQueryParam()
    {
        var uri = new Uri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("focus", out var values) && !string.IsNullOrWhiteSpace(values))
        {
            _focusedRowId = values.ToString();
        }
    }

    private string RowStyleFunc(SinkListItemDto item, int _) =>
        string.Equals(item.Sink.SinkInstanceId, _focusedRowId, StringComparison.Ordinal)
            ? "background: var(--mud-palette-warning-hover);"
            : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _cts = new CancellationTokenSource();
        _pollLoop = PollLoopAsync(_cts.Token);
        await Task.CompletedTask;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAsync();
            }
        }
        catch (OperationCanceledException) { /* expected on dispose */ }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _sinks = await HttpClient.GetFromJsonAsync<SinkListItemDto[]>("/api/v1/sinks")
                ?? Array.Empty<SinkListItemDto>();
            try
            {
                _currentConfig = await HttpClient.GetFromJsonAsync<GatewayConfiguration>("/api/v1/config");
                _currentVersion = null;
            }
            catch
            {
                _currentConfig = null;
                _currentVersion = null;
            }
            _loadError = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { /* component torn down */ }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
        }
    }

    private bool? ConfigEnabledFor(string sinkId)
    {
        if (_currentConfig is null) return null;
        foreach (var s in _currentConfig.Sinks)
        {
            if (string.Equals(s.InstanceId, sinkId, StringComparison.Ordinal))
            {
                return s.Enabled;
            }
        }
        return null;
    }

    // ─── Drawer wiring (M.2b.6.1) ───────────────────────────────────────

    private void OpenToggleDrawer(string sinkId, bool desired)
    {
        if (_currentConfig is null) return;
        try
        {
            var plan = EnableDisablePlanner.Plan(_currentConfig, ConfigEntityKind.Sink, sinkId, desired);
            if (plan.Outcome == EnableDisablePlanOutcome.NoOp)
            {
                _drawerModel.Open(ConfigEntityKind.Sink, sinkId, displayName: sinkId,
                    desiredEnabled: desired, plan.Impact, _currentVersion);
                Snackbar.Add(_drawerModel.NoOpSnackbarText, Severity.Info);
                _drawerModel.TryDismiss();
                return;
            }
            _drawerModel.Open(ConfigEntityKind.Sink, sinkId, displayName: sinkId,
                desiredEnabled: desired, plan.Impact, _currentVersion);
            if (plan.Outcome == EnableDisablePlanOutcome.CrossRecordRefused)
            {
                _drawerModel.BeginApply();
                _drawerModel.RecordCrossRecord(plan.Blockers);
            }
        }
        catch (KeyNotFoundException)
        {
            Snackbar.Add($"Destination '{sinkId}' not found.", Severity.Error);
        }
    }

    private async Task OnDrawerApply()
    {
        var verb = _drawerModel.DesiredEnabled ? "enable" : "disable";
        var url = $"/api/v1/sinks/{Uri.EscapeDataString(_drawerModel.InstanceId)}/{verb}";
        try
        {
            var body = new EnableDisableRequestDto
            {
                ExpectedConfigurationVersion = _drawerModel.ExpectedConfigurationVersion,
            };
            var resp = await HttpClient.PostAsJsonAsync(url, body);
            EnableDisableResponseDto? dto = null;
            try { dto = await resp.Content.ReadFromJsonAsync<EnableDisableResponseDto>(); }
            catch { }
            if (dto is null) { _drawerModel.RecordValidationError($"Unexpected response ({(int)resp.StatusCode})."); return; }
            switch (dto.Outcome)
            {
                case EnableDisableOutcome.Applied:
                    _drawerModel.RecordApplied(dto.AuditRecordId ?? "");
                    Snackbar.Add(_drawerModel.AppliedSnackbarText, Severity.Success);
                    await RefreshAsync();
                    break;
                case EnableDisableOutcome.NoOp:
                    Snackbar.Add(_drawerModel.NoOpSnackbarText, Severity.Info);
                    _drawerModel.TryDismiss();
                    break;
                case EnableDisableOutcome.Conflict:
                    if (dto.Error?.Code == "CONFIG.STALE_VIEW")
                    {
                        _drawerModel.RecordStaleView(dto.Error.CurrentVersion);
                    }
                    else if (dto.Error?.Code == "CONFIG.CROSS_RECORD_REFUSED")
                    {
                        var blockers = dto.Error.Dependents?.Select(d => new DependencyRef(
                                Enum.TryParse<ConfigEntityKind>(d.Kind, ignoreCase: true, out var k) ? k : ConfigEntityKind.Sink,
                                d.Id, d.Name))
                            .ToList() ?? new List<DependencyRef>();
                        _drawerModel.RecordCrossRecord(blockers);
                    }
                    else
                    {
                        _drawerModel.RecordValidationError(dto.Error?.Message ?? "Conflict.");
                    }
                    break;
            }
        }
        catch (TaskCanceledException) { _drawerModel.RecordTimeout(); }
        catch (Exception ex) { _drawerModel.RecordValidationError(ex.Message); }
    }

    private async Task OnDrawerCancel()
    {
        if (_drawerModel.State == DrawerState.Closed) { await RefreshAsync(); }
    }

    // ─── Delete wiring ──────────────────────────────────────────────────

    private async Task ConfirmAndDeleteAsync(string sinkId)
    {
        // Removing a sink strips it from every route's sink list. A route left
        // with no sinks is invalid (must dispatch to ≥1 sink), so it is dropped
        // — surface that in the confirmation.
        var routesUsing = _currentConfig?.Routes
            .Where(r => r.SinkInstanceIds.Contains(sinkId, StringComparer.Ordinal))
            .ToList() ?? new List<RouteConfig>();
        var routesEmptied = routesUsing
            .Where(r => r.SinkInstanceIds.Count == 1)
            .Select(r => r.RouteId)
            .ToList();

        // Lead with what stops, not with "are you sure" — this publishes live plant data.
        var message = $"Publishing to '{sinkId}' stops immediately and anything still buffered for it is discarded.";
        if (routesUsing.Count > 0)
        {
            message += $" It is removed from {routesUsing.Count} route(s).";
        }
        if (routesEmptied.Count > 0)
        {
            message += $" {routesEmptied.Count} route(s) would be left with no destination and are also removed "
                     + $"({string.Join(", ", routesEmptied)}).";
        }
        message += " You can roll back from Config → History.";

        var confirmed = await DialogService.ShowMessageBox(
            title: "Delete destination",
            message: message,
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            await DeleteSinkAsync(sinkId);
        }
    }

    private async Task DeleteSinkAsync(string sinkId)
    {
        try
        {
            var resp = await HttpClient.DeleteAsync(
                $"/api/v1/sinks/{Uri.EscapeDataString(sinkId)}?actor=studio-ui");

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Destination '{sinkId}' deleted.", Severity.Success);
            }
            else if ((int)resp.StatusCode == 404)
            {
                Snackbar.Add($"Destination '{sinkId}' no longer exists.", Severity.Info);
            }
            else if ((int)resp.StatusCode == 409)
            {
                Snackbar.Add(
                    $"Could not delete '{sinkId}': the configuration changed or failed validation. Refresh and retry.",
                    Severity.Warning);
            }
            else
            {
                Snackbar.Add("Could not delete this destination — it is unchanged and still running. Reload the page and try again; if it repeats, check Diagnostics.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }

        await RefreshAsync();
    }

    private void OnRowClick(DataGridRowClickEventArgs<SinkListItemDto> args)
    {
        if (args.Item is { Sink: { SinkInstanceId: var id } })
        {
            Nav.NavigateTo($"/sinks/{id}");
        }
    }

    private bool QuickFilter(SinkListItemDto item)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var q = _searchText.Trim();
        if (item.Sink.SinkInstanceId.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.SinkKind.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        foreach (var rid in item.RouteIds)
        {
            if (rid.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        }
        if (item.Sink.AdapterStateName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (item.Sink.LastErrorCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        return false;
    }

    // Match the SinkInventoryBuilder.State* constants. Mirror the
    // Sources.razor mapping so synthetic state names render consistently
    // across the two pages.
    private static Color StateColor(RouteSinkSummaryDto s)
    {
        if (s.IsDegraded) return Color.Warning;
        return s.AdapterStateName switch
        {
            "Running" => Color.Success,
            "Degraded" => Color.Warning,
            "Stopped" or "Failed" or "Faulted" => Color.Error,
            "Disabled" => Color.Dark,
            "Configured" => Color.Info,
            "Configured / Not running" => Color.Warning,
            _ => Color.Default,
        };
    }

    // Tooltip text for the State chip. Returns the locked
    // "{ErrorCode}: {Message}" form when the row is Faulted and detail
    // exists; null otherwise (caller disables the tooltip).
    private static string? FaultedTooltip(string? stateName, RouteSinkSummaryDto s)
    {
        if (stateName != "Faulted" && stateName != "Failed") return null;
        if (s.LastErrorCode is null) return null;
        if (s.LastErrorMessage is null) return s.LastErrorCode;
        return $"{s.LastErrorCode}: {s.LastErrorMessage}";
    }

    private static Color KindColor(string kind) => kind switch
    {
        "mqtt" => Color.Info,
        "opcua-server" => Color.Secondary,
        "http" => Color.Tertiary,
        "tcp" => Color.Tertiary,
        _ => Color.Default,
    };

    // ─── Operator triage helpers ────────────────────────────────────────
    // "Is data arriving at this destination?" — the one question this page
    // exists to answer. Colour is ALWAYS paired with an icon and a word,
    // never used alone. SinkDetail.razor carries an identical copy; change
    // both together.

    // Repeated break-then-recover is a flapping broker, not a healthy link.
    private static bool IsFlapping(RouteSinkSummaryDto s) =>
        !s.IsDegraded && s.DegradationEventCount >= 3 && s.RecoveryEventCount >= 2;

    private static string DeliveryLabel(RouteSinkSummaryDto s)
    {
        if (s.IsDraining) return "Draining";
        if (s.IsDegraded) return "Rejecting data";
        if (s.AdapterStateName == "Disabled") return "Turned off";
        if (s.AdapterStateName != "Running") return "Not delivering";
        return IsFlapping(s) ? "Unstable" : "Delivering";
    }

    private static Color DeliveryColor(RouteSinkSummaryDto s)
    {
        if (s.IsDraining) return Color.Warning;
        if (s.IsDegraded) return Color.Error;
        if (s.AdapterStateName == "Disabled") return Color.Dark;
        if (s.AdapterStateName != "Running") return Color.Error;
        return IsFlapping(s) ? Color.Warning : Color.Success;
    }

    private static string DeliveryIcon(RouteSinkSummaryDto s)
    {
        if (s.IsDraining) return Icons.Material.Filled.HourglassEmpty;
        if (s.IsDegraded) return Icons.Material.Filled.Block;
        if (s.AdapterStateName == "Disabled") return Icons.Material.Filled.PowerSettingsNew;
        if (s.AdapterStateName != "Running") return Icons.Material.Filled.Cancel;
        return IsFlapping(s) ? Icons.Material.Filled.Sync : Icons.Material.Filled.CheckCircle;
    }

    // Anything that is not healthy states the next step.
    private static string DeliveryHint(RouteSinkSummaryDto s)
    {
        if (s.IsDraining)
            return "Stopping — finishing queued messages. Wait for Stopped before editing it.";
        if (s.IsDegraded)
            return "The endpoint is refusing data and messages are buffering. Open it for the error.";
        if (s.AdapterStateName == "Disabled")
            return "Switched off in configuration. Press Enable to resume delivery.";
        if (s.AdapterStateName != "Running")
            return "Not started. Check it is enabled and wired to a route.";
        if (IsFlapping(s))
            return $"Broke and recovered {OperatorFormat.Count(s.RecoveryEventCount)} times — a flapping broker, not a healthy link.";
        return string.Empty;
    }

    private static string SessionHint(int n) => n == 0
        ? "The endpoint is listening but no SCADA/HMI client has subscribed — nothing is reading this data."
        : "Clients subscribed to this endpoint right now.";

    public async ValueTask DisposeAsync()
    {
        try
        {
            _cts?.Cancel();
            if (_pollLoop is not null) await _pollLoop;
        }
        catch { /* best-effort */ }
        finally { _cts?.Dispose(); }
    }
}
