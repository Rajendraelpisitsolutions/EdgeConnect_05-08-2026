@*
    Diagnostic Bundle page (ADR-0020 G5 — wires the G3 sign-off mockup to the
    G4 management API). The operator workflow is strictly preview → confirm →
    generate:

      1. On load the page calls GET /api/v1/bundle/preview — a real dry-run.
         Nothing is written; the manifest shown == the manifest that will be
         generated (a builder test asserts this).
      2. The operator reads exactly WHAT will leave (included entries), WHY
         something was excluded (license file etc.), and WHAT was masked.
      3. If the secret-shape detector flagged any INCLUDE'd value, Generate
         stays disabled until the operator ticks the acknowledgement box —
         the same gate the builder enforces server-side (a 400 if bypassed).
      4. Generate POSTs reason + acknowledgement, receives the zip bytes, and
         hands them to bundleDownload.saveBase64 for a browser "save as".

    Unlike Backup (a plain anchor GET), generation is a POST carrying a body,
    so it goes through HttpClient + JS-interop download rather than an <a>.

    Reference: docs/sessions/2026-05-31-adr0020-bundle-generation-plan-v2.md;
               docs/sessions/2026-05-30-ux-mockups/6-bundle-preview.html.
*@
@page "/bundle"
@using System.Net.Http.Json
@using ElpisEdgeConnect.Management.Bundle
@inject HttpClient HttpClient
@inject IJSRuntime JS

<PageTitle>Diagnostic bundle · Connectivity Studio</PageTitle>

<div class="page-heading">
    <span class="page-heading__icon"><MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Medium" /></span>
    <div class="page-heading__text">
        <div class="page-heading__title">Generate diagnostic bundle</div>
        <div class="page-heading__desc">
            A support artifact you can safely share — review exactly what will leave the gateway before the ZIP is created.
        </div>
    </div>
</div>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
        <strong>Could not build the preview.</strong> @_loadError
        <MudButton Variant="Variant.Text" Color="Color.Error" Class="ml-2"
                   OnClick="@(() => _ = LoadPreviewAsync())" Style="text-transform:none;">
            Retry
        </MudButton>
    </MudAlert>
}
else if (_preview is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    <MudText Typo="Typo.body2" Color="Color.Secondary">Running the dry-run preview…</MudText>
}
else
{
    var p = _preview;
    var s = p.RedactionSummary;

    @* ---- Summary + contributors ---- *@
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="6" Wrap="Wrap.Wrap" Class="mb-2">
            <div><MudText Typo="Typo.caption" Color="Color.Secondary">Entries included</MudText>
                <MudText Typo="Typo.h5">@s.IncludedEntries</MudText></div>
            <div><MudText Typo="Typo.caption" Color="Color.Secondary">Fields masked</MudText>
                <MudText Typo="Typo.h5" Style="color:var(--mud-palette-warning);">@s.MaskedFields</MudText></div>
            <div><MudText Typo="Typo.caption" Color="Color.Secondary">Fields stripped</MudText>
                <MudText Typo="Typo.h5" Style="color:var(--mud-palette-error);">@s.StrippedFields</MudText></div>
            <div><MudText Typo="Typo.caption" Color="Color.Secondary">Surfaces excluded</MudText>
                <MudText Typo="Typo.h5" Color="Color.Secondary">@s.ExcludedSurfaces</MudText></div>
            <div><MudText Typo="Typo.caption" Color="Color.Secondary">Bundle size</MudText>
                <MudText Typo="Typo.h5">@OperatorFormat.Bytes(p.TotalBytes)</MudText></div>
        </MudStack>
        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">
            Contributors (@p.Contributors.Count) — exactly what produced this bundle
        </MudText>
        <MudTable T="BundleContributorInfo" Items="@p.Contributors" Dense="true" Hover="false" Bordered="false" Elevation="0">
            <HeaderContent>
                <MudTh>Contributor</MudTh>
                <MudTh>Capability</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><code>@context.Name</code></MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="text-transform:none;">@context.Capability</MudChip></MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* ---- Q1: what will be included ---- *@
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="border-left:4px solid #2e7d32;">
        <MudText Typo="Typo.h6" Class="mb-1">✓ Will be included</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">Q1 — what leaves the gateway</MudText>
        <MudTable T="KeyValuePair<string, string>" Items="@p.Manifest.Checksums" Dense="true" Hover="false" Bordered="false" Elevation="0">
            <HeaderContent>
                <MudTh>Entry</MudTh>
                <MudTh>Checksum</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><code>@context.Key</code></MudTd>
                <MudTd><MudText Typo="Typo.caption" Style="font-family:monospace;">@Shorten(context.Value)</MudText></MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* ---- Q3: what was masked / stripped ---- *@
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="border-left:4px solid #ed6c02;">
        <MudText Typo="Typo.h6" Class="mb-1">● Will be redacted</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            Q3 — what was masked (key kept, value blanked) or stripped (key removed):
            <strong>@s.MaskedFields masked</strong> · <strong>@s.StrippedFields stripped</strong>
        </MudText>
        @if (p.Manifest.Redactions.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No fields were masked or stripped in this bundle.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Bordered="false" Elevation="0">
                <thead><tr><th>File</th><th>Redacted field</th></tr></thead>
                <tbody>
                    @foreach (var entry in p.Manifest.Redactions)
                    {
                        @foreach (var path in entry.Value)
                        {
                            <tr><td><code>@entry.Key</code></td><td><code>@path</code></td></tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    @* ---- Secret-shape detector warnings ---- *@
    @if (p.SecretShapeWarningCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-2">
            <strong>@p.SecretShapeWarningCount value(s) look secret-shaped — and WILL be included in the bundle exactly as stored.</strong>
            The detector only flags them for your review; it does <strong>not</strong> mask, strip, or change them.
            If one is a real secret, click <em>Cancel</em>, remove or relocate it in your configuration, and regenerate.
            Otherwise acknowledge below to confirm the bundle is safe to share.
        </MudAlert>
        <MudPaper Elevation="1" Class="pa-4 mb-4" Style="border-left:4px solid var(--mud-palette-warning);">
            <MudSimpleTable Dense="true" Bordered="false" Elevation="0">
                <thead><tr><th>File</th><th>Field</th><th>Detector</th></tr></thead>
                <tbody>
                    @foreach (var w in p.SecretShapeWarnings)
                    {
                        <tr>
                            <td><code>@w.File</code></td>
                            <td><code>@w.Path</code></td>
                            <td><MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="text-transform:none;">@w.Detail</MudChip></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    @* ---- Q2: why something was excluded ---- *@
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="border-left:4px solid #9e9e9e;">
        <MudText Typo="Typo.h6" Class="mb-1">⌀ Will be excluded</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">Q2 — why something is not in the bundle</MudText>
        @if (p.Manifest.Excluded.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing was explicitly excluded.</MudText>
        }
        else
        {
            <ul style="margin:0; padding-left:1.25rem;">
                @foreach (var note in p.Manifest.Excluded)
                {
                    <li><MudText Typo="Typo.body2">@note</MudText></li>
                }
            </ul>
        }
    </MudPaper>

    @* ---- Safe-to-share + reason + acknowledge + generate ---- *@
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
            <strong>Safe to share.</strong>
            Passwords, tokens, and key material are masked or stripped before the ZIP is created, and the
            license file (with its customer/site binding) never leaves the gateway. Share the resulting ZIP
            only over a channel appropriate to your organisation.
        </MudAlert>

        <MudTextField @bind-Value="_reason"
                      Label="Reason for generating (optional)"
                      Placeholder="e.g. support ticket #1234 — intermittent MQTT disconnects"
                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                      HelperText="Recorded in the BUNDLE.GENERATED audit entry alongside the operator and a manifest hash."
                      Class="mb-4" />

        @if (p.SecretShapeWarningCount > 0)
        {
            <MudPaper Elevation="0" Class="pa-3 mb-4" Style="border:1px solid var(--mud-palette-warning); border-radius:6px;">
                <MudCheckBox @bind-Value="_acknowledged" Color="Color.Warning" Dense="true">
                    <MudText Typo="Typo.body2">
                        I have reviewed the <strong>@p.SecretShapeWarningCount</strong> value(s) flagged as secret-shaped
                        (@SecretShapeFieldList()), understand they will be included verbatim, and confirm this bundle is safe to share.
                    </MudText>
                </MudCheckBox>
            </MudPaper>
        }

        @if (_generateError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@_generateError</MudAlert>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Download"
                       Disabled="@(!CanGenerate)"
                       OnClick="GenerateAsync"
                       Style="text-transform:none;">
                @(_generating ? "Generating…" : "Generate bundle")
            </MudButton>
            @if (_generating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
            }
            <MudSpacer />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @if (p.SecretShapeWarningCount > 0 && !_acknowledged)
                {
                    <span>⚠ Generate stays disabled until you acknowledge the secret-shaped value(s). </span>
                }
                Nothing has left the gateway yet — this is a preview.
            </MudText>
        </MudStack>
    </MudPaper>
}

@code {
    private BundlePreview? _preview;
    private string? _loadError;

    private string _reason = string.Empty;
    private bool _acknowledged;
    private bool _generating;
    private string? _generateError;

    private bool CanGenerate =>
        _preview is not null
        && !_generating
        && (_preview.SecretShapeWarningCount == 0 || _acknowledged);

    protected override async Task OnInitializedAsync() => await LoadPreviewAsync();

    private async Task LoadPreviewAsync()
    {
        _loadError = null;
        _preview = null;
        _generateError = null;
        try
        {
            _preview = await HttpClient.GetFromJsonAsync<BundlePreview>("/api/v1/bundle/preview");
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private async Task GenerateAsync()
    {
        if (!CanGenerate) return;
        _generating = true;
        _generateError = null;
        try
        {
            var reason = string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim();
            var body = new GenerateBundleRequest(reason, _acknowledged);
            var resp = await HttpClient.PostAsJsonAsync("/api/v1/bundle", body);

            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                var fileName = resp.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                               ?? "edgeconnect-bundle.zip";
                var b64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("bundleDownload.saveBase64", fileName, b64, "application/zip");
            }
            else
            {
                // 400 = acknowledgement gate (rare here — the button enforces it,
                // but a stale preview could race). 500 = preview unavailable.
                string? detail = null;
                try
                {
                    var problem = await resp.Content.ReadFromJsonAsync<ProblemLite>();
                    detail = problem?.Detail ?? problem?.Title;
                }
                catch { /* non-JSON body */ }

                _generateError = detail ?? $"Generation failed ({(int)resp.StatusCode}).";

                // A 400 means our preview is out of date — re-run it so the
                // operator sees the current secret-shape state before retrying.
                if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    await LoadPreviewAsync();
                }
            }
        }
        catch (Exception ex)
        {
            _generateError = ex.Message;
        }
        finally
        {
            _generating = false;
        }
    }

    private string SecretShapeFieldList()
    {
        if (_preview is null || _preview.SecretShapeWarnings.Count == 0) return string.Empty;
        return string.Join(", ", _preview.SecretShapeWarnings.Select(w => w.Path));
    }

    private static string Shorten(string checksum)
    {
        // "sha256:<64 hex>" → "sha256:abcd…1234" so the table stays readable.
        var idx = checksum.IndexOf(':');
        var prefix = idx >= 0 ? checksum[..(idx + 1)] : string.Empty;
        var hex = idx >= 0 ? checksum[(idx + 1)..] : checksum;
        if (hex.Length <= 12) return checksum;
        return $"{prefix}{hex[..6]}…{hex[^4..]}";
    }

    // Byte sizes come from Components/Shared/OperatorFormat so every page scales a size identically.

    /// <summary>Minimal ProblemDetails shape for reading the API's error body.</summary>
    private sealed record ProblemLite(string? Title, string? Detail);
}
