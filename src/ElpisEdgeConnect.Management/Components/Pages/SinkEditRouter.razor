@*
    SinkEditRouter — single resolver page for /destinations/{instanceId}/edit.

    M.2d.3 v2 §3.3 — mirrors SourceEditRouter.razor. Dispatches to the
    correct sink wizard (or one of three non-happy-path panels) by
    inspecting the loaded sink's ProtocolName.

    Two known sink protocols in this Studio build:
       · "mqtt"         → AddMqttDestination
       · "opcua-server" → AddOpcUaServerDestination

    Four-branch UX matrix (same as SourceEditRouter §5.2):
       1. RenderWizard    — protocol known + wizard present
       2. LicenseDisabled — protocol known, license module disabled
       3. UnknownProtocol — ProtocolName not recognised
       4. WizardMissing   — protocol registered but no Razor wizard

    Optimistic concurrency: captures CurrentVersionId at hydration
    time as BaseVersionId for the save-collision check.

    Reference: docs/sessions/2026-05-26-m2d3-sink-route-editors-plan-v2.md §3.3
*@

@page "/destinations/{InstanceId}/edit"
@using System.Net
@using System.Text.Json
@using ElpisEdgeConnect.Core.Configuration
@using ElpisEdgeConnect.Management.Components.Pages.SinkWizards
@using ElpisEdgeConnect.Management.Contracts.Config
@using ElpisEdgeConnect.Management.Wizards
@inject HttpClient HttpClient
@inject NavigationManager Nav
@inject ILogger<SinkEditRouter> Logger

<PageTitle>Edit destination · Connectivity Studio</PageTitle>

@if (_loadState == LoadState.Loading)
{
    <MudPaper Class="pa-6 my-4" data-testid="sink-edit-loading">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <MudText>Loading destination <code>@InstanceId</code>…</MudText>
        </MudStack>
    </MudPaper>
}
else if (_loadState == LoadState.NotFound)
{
    <MudPaper Class="pa-6 my-4" Outlined="true" data-testid="sink-edit-not-found">
        <MudStack Spacing="3">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.h5">Destination not found</MudText>
            </MudStack>
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                No destination named <code>@InstanceId</code> exists in the current configuration.
                It may have been deleted by another session, or the link you followed is stale.
            </MudAlert>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/sinks"
                       data-testid="sink-edit-back-link">
                Back to destinations
            </MudButton>
        </MudStack>
    </MudPaper>
}
else if (_loadState == LoadState.LoadError)
{
    <MudPaper Class="pa-6 my-4" Outlined="true" data-testid="sink-edit-load-error">
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <strong>Failed to load destination.</strong> @_loadErrorMessage
        </MudAlert>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync"
                   Class="mt-3">
            Retry
        </MudButton>
    </MudPaper>
}
else if (_loadState == LoadState.Loaded && _sink is not null)
{
    @* Banner — hydration source (current config) *@
    <MudAlert Severity="Severity.Info"
              Variant="Variant.Outlined"
              Class="my-3"
              data-testid="hydration-source-banner-current">
        <strong>Editing runtime configuration</strong> — version
        <code>@_baseVersionId</code>.
    </MudAlert>

    @switch (_uxState)
    {
        case UxState.RenderWizard:
            var editCtx = EditModeContext.Edit(_sink.InstanceId, _baseVersionId ?? "unknown");
            <div data-testid="render-wizard-active">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">
                    BaseVersionId: <code data-testid="base-version-id">@_baseVersionId</code>
                </MudText>
                @switch (_sink.ProtocolName)
                {
                    case "mqtt":
                        <AddMqttDestination EditMode="@editCtx" HydratedConfig="@_sink" />
                        break;
                    case "opcua-server":
                        <AddOpcUaServerDestination EditMode="@editCtx" HydratedConfig="@_sink" />
                        break;
                    default:
                        <WizardNotAvailablePanel
                            ProtocolName="@_sink.ProtocolName"
                            ProtocolDisplayName="@ProtocolDisplayNameFor(_sink.ProtocolName)"
                            InstanceId="@_sink.InstanceId" />
                        break;
                }
            </div>
            break;

        case UxState.LicenseDisabled:
            <LicenseModuleDisabledPanel
                LicenseModuleKey="@LicenseModuleKeyFor(_sink.ProtocolName)"
                ProtocolDisplayName="@ProtocolDisplayNameFor(_sink.ProtocolName)"
                InstanceId="@_sink.InstanceId" />
            break;

        case UxState.UnknownProtocol:
            <UnsupportedProtocolPanel
                ProtocolName="@_sink.ProtocolName"
                InstanceId="@_sink.InstanceId"
                RawJson="@_sinkRawJson" />
            break;

        case UxState.WizardMissing:
            <WizardNotAvailablePanel
                ProtocolName="@_sink.ProtocolName"
                ProtocolDisplayName="@ProtocolDisplayNameFor(_sink.ProtocolName)"
                InstanceId="@_sink.InstanceId" />
            break;
    }
}

@code {
    [Parameter] public string InstanceId { get; set; } = string.Empty;

    private LoadState _loadState = LoadState.Loading;
    private string? _loadErrorMessage;
    private UxState _uxState;
    private SinkInstanceConfig? _sink;
    private string? _baseVersionId;
    private string? _sinkRawJson;

    internal static readonly IReadOnlySet<string> ProtocolsWithEditWizard =
        new HashSet<string>(StringComparer.Ordinal)
        {
            "mqtt",
            "opcua-server",
        };

    internal static readonly IReadOnlySet<string> RegisteredSinkProtocols =
        new HashSet<string>(StringComparer.Ordinal)
        {
            "mqtt",
            "opcua-server",
        };

    internal static UxState ResolveUxState(
        string protocolName,
        bool isLicenseEnabled,
        IReadOnlySet<string>? registeredProtocols = null,
        IReadOnlySet<string>? protocolsWithWizard = null)
    {
        registeredProtocols ??= RegisteredSinkProtocols;
        protocolsWithWizard ??= ProtocolsWithEditWizard;

        if (!registeredProtocols.Contains(protocolName))
            return UxState.UnknownProtocol;
        if (!isLicenseEnabled)
            return UxState.LicenseDisabled;
        if (!protocolsWithWizard.Contains(protocolName))
            return UxState.WizardMissing;
        return UxState.RenderWizard;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadState = LoadState.Loading;
        _loadErrorMessage = null;
        _sink = null;
        _sinkRawJson = null;

        if (string.IsNullOrWhiteSpace(InstanceId))
        {
            _loadState = LoadState.NotFound;
            return;
        }

        try
        {
            var versionDto = await HttpClient.GetFromJsonAsync<CurrentConfigVersionDto>("/api/v1/config/version");
            _baseVersionId = versionDto?.VersionId ?? "unknown";

            var config = await HttpClient.GetFromJsonAsync<GatewayConfiguration>("/api/v1/config");
            if (config is null)
            {
                _loadState = LoadState.LoadError;
                _loadErrorMessage = "Configuration response was empty.";
                return;
            }

            var match = config.Sinks.FirstOrDefault(s =>
                string.Equals(s.InstanceId, InstanceId, StringComparison.Ordinal));
            if (match is null)
            {
                _loadState = LoadState.NotFound;
                return;
            }

            _sink = match;
            _sinkRawJson = JsonSerializer.Serialize(match,
                new JsonSerializerOptions { WriteIndented = true });

            var isLicensed = true;
            _uxState = ResolveUxState(match.ProtocolName, isLicensed);
            _loadState = LoadState.Loaded;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _loadState = LoadState.NotFound;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load sink {InstanceId} for editing.", InstanceId);
            _loadState = LoadState.LoadError;
            _loadErrorMessage = ex.Message;
        }
    }

    internal static string ProtocolDisplayNameFor(string protocolName) =>
        protocolName switch
        {
            "mqtt" => "MQTT",
            "opcua-server" => "OPC UA Server",
            _ => protocolName,
        };

    internal static string LicenseModuleKeyFor(string protocolName) =>
        protocolName switch
        {
            "mqtt" => "sink-mqtt",
            "opcua-server" => "sink-opcua-server",
            _ => $"sink-{protocolName}",
        };

    internal enum LoadState
    {
        Loading,
        Loaded,
        NotFound,
        LoadError,
    }

    internal enum UxState
    {
        RenderWizard,
        LicenseDisabled,
        UnknownProtocol,
        WizardMissing,
    }
}
