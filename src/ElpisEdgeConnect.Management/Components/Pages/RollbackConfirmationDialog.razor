@*
    Rollback confirmation dialog. Same friction pattern as Apply —
    operator must type "ROLLBACK" before the destructive action
    button activates. No diff preview today because rollback's diff
    target is "current ↔ historical-version" which would require a
    second endpoint; M.2a operators have the version summary in the
    history table to reference instead.
*@

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
            <strong>Rolling back replaces the current active configuration.</strong>
            A new audit entry is written (treated as a fresh apply with action
            <code>RolledBack</code>) and the runtime hot-reloads to the older
            configuration.
        </MudAlert>

        <MudText Typo="Typo.body2" Class="mb-3">
            Target version: <code>@VersionId</code>
        </MudText>

        <MudTextField @bind-Value="_typedConfirm" Label="Type ROLLBACK to confirm"
                      Variant="Variant.Outlined" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="text-transform:none;">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(_typedConfirm != "ROLLBACK")"
                   Style="text-transform:none;">
            Rollback
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string VersionId { get; set; } = string.Empty;

    private string _typedConfirm = string.Empty;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
