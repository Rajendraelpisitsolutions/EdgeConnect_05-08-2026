<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production web.config for Elpis IT Solutions — www.elpisitsolutions.com
  Host: MochaHost Swift Web Hosting (Windows / IIS)
  Generated: 2026-06-07 — go-live Wave C

  Rules in order:
    1. Canonical: /index.html → /
    4. Canonical: strip .html extension (e.g. /platform.html → /platform)
    5. Old-site 301 redirects (Angular routes from old elpisitsolutions.com)
    6. Pretty URL rewrite: /platform → platform.html (internal, transparent)
-->
<configuration>
  <system.webServer>

    <!-- Serve index.html as the default document for / -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Custom 404 page (requires httpErrors to be unlocked on the host;
         if this causes a 500, remove this block — MochaHost will use its
         default error page until IIS Manager access is available) -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <rewrite>
      <rules>
        <!-- FORCE HTTPS: removed — MochaHost terminates SSL at the proxy so
             {HTTPS} is always OFF inside IIS, causing ERR_TOO_MANY_REDIRECTS.
             HTTPS is handled by MochaHost infrastructure. -->

        <!-- ─── 2. CANONICAL: /index.html → / ──────────────────────── -->
        <rule name="canonical-index" stopProcessing="true">
          <match url="^index\.html$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- ─── 3. CANONICAL: strip .html (e.g. /platform.html → /platform) -->
        <rule name="canonical-strip-html" stopProcessing="true">
          <match url="^([a-z0-9][a-z0-9_-]*)\.html$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- ─── BLOG: /blog/<slug> pretty URLs ──────────────────────────
             Articles live in the /blog/ folder. Strip .html to the clean
             URL, then rewrite the clean URL back to the physical file.
             /blog/ serves blog/index.html via the default document. -->
        <rule name="blog-strip-html" stopProcessing="true">
          <match url="^blog/([a-z0-9-]+)\.html$" ignoreCase="true" />
          <action type="Redirect" url="/blog/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="blog-pretty" stopProcessing="true">
          <match url="^blog/([a-z0-9-]+)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="blog/{R:1}.html" />
        </rule>

        <!-- ─── SERVICES: /services/<slug> pretty URLs (mirrors /blog) ── -->
        <rule name="services-strip-html" stopProcessing="true">
          <match url="^services/([a-z0-9-]+)\.html$" ignoreCase="true" />
          <action type="Redirect" url="/services/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="services-pretty" stopProcessing="true">
          <match url="^services/([a-z0-9-]+)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="services/{R:1}.html" />
        </rule>

        <!-- ─── 4. OLD-SITE 301 REDIRECTS ───────────────────────────── -->

        <!-- /home → / -->
        <rule name="old-home" stopProcessing="true">
          <match url="^home$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- Software: e-on → EdgeConnect -->
        <rule name="old-e-on" stopProcessing="true">
          <match url="^Our-Software-Assistance/e-on$" ignoreCase="true" />
          <action type="Redirect" url="/edgeconnect" redirectType="Permanent" />
        </rule>

        <!-- Software: e-remos → EREMOS V2 -->
        <rule name="old-e-remos" stopProcessing="true">
          <match url="^Our-Software-Assistance/e-remos$" ignoreCase="true" />
          <action type="Redirect" url="/eremos-v2" redirectType="Permanent" />
        </rule>

        <!-- IoT/Hardware products -->
        <rule name="old-e-idos" stopProcessing="true">
          <match url="^IOT-Solutions/e-idos$" ignoreCase="true" />
          <action type="Redirect" url="/e-idos" redirectType="Permanent" />
        </rule>

        <rule name="old-m-tracker" stopProcessing="true">
          <match url="^IOT-Solutions/m-tracker$" ignoreCase="true" />
          <action type="Redirect" url="/mtracker" redirectType="Permanent" />
        </rule>

        <rule name="old-edge-gateway" stopProcessing="true">
          <match url="^IOT-Solutions/edge-gateway$" ignoreCase="true" />
          <action type="Redirect" url="/edge-gateway" redirectType="Permanent" />
        </rule>

        <rule name="old-m-daq" stopProcessing="true">
          <match url="^IOT-Solutions/m-daq$" ignoreCase="true" />
          <action type="Redirect" url="/mdaq" redirectType="Permanent" />
        </rule>

        <rule name="old-vas" stopProcessing="true">
          <match url="^IOT-Solutions/vibration-analyser-system$" ignoreCase="true" />
          <action type="Redirect" url="/vas" redirectType="Permanent" />
        </rule>

        <!-- Old /our-services/* → the new Services section -->
        <rule name="old-services" stopProcessing="true">
          <match url="^our-services(/.*)?$" ignoreCase="true" />
          <action type="Redirect" url="/services" redirectType="Permanent" />
        </rule>

        <!-- About (no about page yet → homepage) -->
        <rule name="old-about" stopProcessing="true">
          <match url="^about$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- Privacy policy (old slug → new clean URL) -->
        <rule name="old-privacy-policy" stopProcessing="true">
          <match url="^privacy-policy$" ignoreCase="true" />
          <action type="Redirect" url="/privacy" redirectType="Permanent" />
        </rule>

        <!-- ─── 5. PRETTY URLS ───────────────────────────────────────────
             Internally rewrites /platform → platform.html (transparent;
             browser URL stays /platform). Only fires when:
               - the literal path is not an existing file (e.g. styles.css)
               - the literal path is not a directory
               - PAGENAME.html exists on disk                               -->
        <rule name="pretty-urls" stopProcessing="true">
          <match url="^([a-z0-9][a-z0-9_-]*)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}"      matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}"      matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
